{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Lykompanion",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Lykompanion (dev / hot-reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--host", "0.0.0.0", "--port", "6692", "--reload"],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}

# OpenRouter (OpenAI-compatible) LLM provider. Must be an audio-input-capable model - this is a
# voice companion, so speech is always sent directly to the main chat model (no local STT).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# TTS
TTS_PROVIDER=kokoro
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart
OPENROUTER_TTS_MODEL=
OPENROUTER_VOICE=
TTS_SPEED=1.0

# Server
HOST=0.0.0.0
PORT=8000
